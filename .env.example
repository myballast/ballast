# Copy to .env and fill in. `make api`, `make worker` and `make dev` read it;
# git ignores .env.

# GitHub OAuth app: https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8080/auth/github/callback
BALLAST_GITHUB_CLIENT_ID=
BALLAST_GITHUB_CLIENT_SECRET=

# Google OAuth client (optional): https://console.cloud.google.com/apis/credentials
#   Type: Web application
#   Authorized redirect URI: http://localhost:8080/auth/google/callback
BALLAST_GOOGLE_CLIENT_ID=
BALLAST_GOOGLE_CLIENT_SECRET=

# The organization the worker takes runs from. Defaults to the seeded one;
# set it to your own, printed in the API log on your first sign-in, to run
# tests from the account you signed in with.
# BALLAST_WORKER_ORG_ID=
