# Settings of a self-hosted Ballast, read by compose.selfhost.yaml.
#
# You do not need to copy this file: `make selfhost` writes .env.selfhost on its
# first run, with the secrets generated, and never overwrites a value you set.
# This lists what it writes, and what you add yourself.
#
# git and every Docker build context ignore .env.selfhost.

# ─── Generated by make selfhost ───────────────────────────────────────────────

# The database owner (runs the migrations) and the application role (everything
# else; neither a superuser nor BYPASSRLS). Hex, so they fit in a URL as they are.
POSTGRES_PASSWORD=
BALLAST_APP_PASSWORD=

# Encrypts the secrets of an environment at rest. Changing it makes every
# stored secret unreadable: keep it with your backups of the database.
BALLAST_SECRET_KEY=

# Signs the session cookie. Changing it signs everybody out.
BALLAST_SESSION_SECRET=

# Found on this machine: the user who owns the run directory, and the group of
# the Docker socket, which the worker must belong to.
BALLAST_SELFHOST_UID=
BALLAST_SELFHOST_GID=
BALLAST_DOCKER_GID=

# Where the worker writes each run's script. An absolute path on the host,
# under this checkout: Docker Desktop shares it with its virtual machine.
BALLAST_SELFHOST_WORK_DIR=

# ─── Yours to set: at least one sign-in provider ──────────────────────────────
#
# Ballast stores no password: people sign in with GitHub or Google. Create an
# OAuth app, then run `make selfhost` again.
#
# GitHub: https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/auth/github/callback
BALLAST_GITHUB_CLIENT_ID=
BALLAST_GITHUB_CLIENT_SECRET=

# Google: https://console.cloud.google.com/apis/credentials, "Web application"
#   Authorized redirect URI: http://localhost:3000/auth/google/callback
BALLAST_GOOGLE_CLIENT_ID=
BALLAST_GOOGLE_CLIENT_SECRET=

# ─── Optional ─────────────────────────────────────────────────────────────────

# The port the front end is published on, on 127.0.0.1. Default 3000. Change the
# two addresses below and the OAuth app's URLs with it.
# BALLAST_HTTP_PORT=3000

# Where browsers reach Ballast. Behind a reverse proxy with a certificate, both
# are its https address; anywhere but this machine, they must be https.
# BALLAST_PUBLIC_URL=http://localhost:3000
# BALLAST_WEB_URL=http://localhost:3000
